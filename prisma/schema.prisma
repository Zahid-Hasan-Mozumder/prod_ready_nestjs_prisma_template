generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id @default(uuid())
  email String  @unique
  name  String?

  posts Post[]

  @@index([id])
  @@index([email])
  @@map("users")
}

model Post {
  id        String  @id @default(uuid())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  String

  author User @relation(fields: [authorId], references: [id])

  @@index([id])
  @@index([authorId])
  @@map("posts")
}
